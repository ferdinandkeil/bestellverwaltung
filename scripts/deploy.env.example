# Vorlage für scripts/deploy.env (wird nicht committet – das Repo ist öffentlich).
#   cp scripts/deploy.env.example scripts/deploy.env   und anpassen
DEPLOY_SSH=<user>@<host>.uberspace.de      # SSH-Ziel (Schlüssel-Login)
DEPLOY_URL=https://<domain>                # Adresse der App
DEPLOY_DIR=bestellverwaltung               # Verzeichnis im Home des Uberspace
DEPLOY_SERVICE=bestellverwaltung           # Name des supervisord-Dienstes
